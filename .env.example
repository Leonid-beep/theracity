# === Обязательно для приложения (production) ===
# Строка подключения PostgreSQL (миграции Prisma и рантайм)
# У облачных БД часто нужен SSL, например: ?schema=public&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
#
# Миграции в production: отдельно от Vercel Build, когда меняется prisma/schema или есть новые migrations.
# Команда: npx prisma migrate deploy   (или: npm run prisma:migrate:deploy)
# Перед первым деплоем: создайте БД, задайте DATABASE_URL, выполните migrate deploy, затем деплой приложения.

# Секрет подписи JWT (middleware + сессия в cookie). Сгенерируйте случайную длинную строку.
JWT_SECRET="replace-with-long-random-secret"

# Необязательно: принудительно включить/выключить флаг Secure для auth-cookie.
# Оставьте пустым, чтобы приложение определяло это по протоколу запроса.
# AUTH_COOKIE_SECURE="true"

# S3-совместимое хранилище (например Yandex Object Storage)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="my-bucket-name"
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# Emails учётных записей с правами загрузки фото и расширенного удаления
# Можно перечислить несколько адресов через запятую
ADMIN_EMAILS="admin@example.com,second-admin@example.com"

# === Необязательно (функция восстановления пароля) ===
# Если не заданы — POST /api/auth/forgot-password не сможет отправить письмо
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# === Системное (на Vercel выставляется автоматически) ===
# NODE_ENV=production
